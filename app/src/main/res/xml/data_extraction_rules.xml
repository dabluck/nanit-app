<?xml version="1.0" encoding="utf-8"?><!--
    The baby's photo, name and birthday live in getFilesDir() and must not leave the device.
    Some Android 12 devices still allow device transfer with allowBackup="false", so exclude both.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude
            domain="file"
            path="." />
    </cloud-backup>
    <device-transfer>
        <exclude
            domain="file"
            path="." />
    </device-transfer>
</data-extraction-rules>
